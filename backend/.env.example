DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project_governance
# Local dev without Postgres available:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Then run: python -m scripts.bootstrap_sqlite  (and optionally scripts.seed_sqlite_dev)
API_KEY=change-me-local-dev-key
CORS_ORIGINS=http://localhost:3000
DOCUMENT_STORAGE_DIR=./storage/documents

# AUTH_TYPE=no_password  (identifier-only, dev fallback) or AUTH_TYPE=onelogin
AUTH_TYPE=no_password
SESSION_SECRET=change-me-session-secret
SESSION_TTL_MINUTES=480
# Set true once served over HTTPS (required before enabling AUTH_TYPE=onelogin
# outside localhost) — see deployment.md.
SESSION_COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000

# Only required when AUTH_TYPE=onelogin — see Part A of the OneLogin
# integration plan for how to obtain these from the OneLogin admin portal.
ONELOGIN_CLIENT_ID=
ONELOGIN_CLIENT_SECRET=
ONELOGIN_ISSUER=https://<subdomain>.onelogin.com/oidc/2
# NOTE: this must be the FRONTEND's origin (proxied to the backend by
# next.config.ts's rewrite), not the backend's own host:port directly —
# otherwise the session cookie the callback sets ends up scoped to the
# backend's origin instead of the frontend's, and every subsequent same-origin
# /api/v1/* call from the browser won't carry it. Register this exact value
# in OneLogin as the app's redirect URI.
ONELOGIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/onelogin/callback
